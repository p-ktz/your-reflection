# cloudflared's official image includes a multi-architecture binary at this path.
FROM cloudflare/cloudflared:2026.11.1 AS cloudflared

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY --from=cloudflared /usr/local/bin/cloudflared /usr/local/bin/cloudflared
COPY launch_demo.py ./
COPY vendor ./vendor
COPY dist ./dist

# The server generates the current public URL's QR inside dist/assets.
RUN useradd --uid 10001 --create-home app && chown -R app:app /app/dist
USER app

EXPOSE 8766

ENTRYPOINT ["python", "launch_demo.py"]
CMD ["--public", "--no-browser", "--bind", "0.0.0.0", "--port", "8766"]
